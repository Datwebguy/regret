# REGRET application configuration
# Copy to .env and fill in real values. Never commit .env.

# application
REGRET_ENV=development
REGRET_SECRET_KEY=replace-with-a-long-random-string
REGRET_ENCRYPTION_KEY=
REGRET_PUBLIC_URL=http://127.0.0.1:8000
REGRET_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production (Fly.io): set these as app env / secrets, never commit values.
# REGRET_ENV=production
# REGRET_PUBLIC_URL=https://YOUR-APP.fly.dev
# REGRET_CORS_ORIGINS=https://YOUR-APP.fly.dev
# REGRET_DATABASE_URL=sqlite:////data/regret.db
# ALPACA_OAUTH_REDIRECT_URI=https://YOUR-APP.fly.dev/api/alpaca/callback

# database — use PostgreSQL in production
# sqlite for local development only
REGRET_DATABASE_URL=sqlite:///./data/regret.db
# REGRET_DATABASE_URL=postgresql+psycopg://regret:regret@127.0.0.1:5432/regret

# trading environment default for new connections
# paper | live — live execution stays disabled until explicitly enabled
REGRET_DEFAULT_TRADING_ENVIRONMENT=paper
REGRET_LIVE_TRADING_ENABLED=false

# Alpaca Connect OAuth2 — primary multi-user connection.
# Register the app at https://app.alpaca.markets/connect
# Docs: https://docs.alpaca.markets/us/docs/using-oauth2-and-trading-api
# Each REGRET user authorizes their own existing Alpaca account.
# Client secret stays on the server. Never put it in frontend code.
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/alpaca/callback

# Development paper credentials for THIS operator's own paper account.
# Used only as a server-side market-data source in development.
# Never used as the trading identity of other REGRET users.
# Never sent to the browser. Never commit real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional dedicated market-data keys. If empty, ALPACA_API_KEY / SECRET
# are used for market data only (not for sending other users' orders).
ALPACA_DATA_API_KEY_ID=
ALPACA_DATA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Featherless AI Serverless Inference (Hackathon Partner)
# Serverless open-source models: Llama 3.3 70B, DeepSeek R1/V3, Qwen 2.5 72B
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=meta-llama/Llama-3.3-70B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Generic OpenAI-compatible LLM endpoint (fallback)
REGRET_LLM_BASE_URL=https://api.featherless.ai/v1
REGRET_LLM_API_KEY=
REGRET_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct

# session
REGRET_SESSION_COOKIE=regret_session
REGRET_SESSION_TTL_HOURS=168
REGRET_APPROVAL_TTL_SECONDS=300

# market data freshness (seconds) while the market is open
REGRET_QUOTE_MAX_AGE_SECONDS=60
REGRET_BAR_MAX_AGE_SECONDS=900
